; Offline lower-filter topology probe only; not for installation.
[Version]
Signature = "$WINDOWS NT$"
Class = SCSIAdapter
ClassGuid = {4d36e97b-e325-11ce-bfc1-08002be10318}
Provider = %Provider%
CatalogFile = mt8167-msdc-readonly.cat
DriverVer = 11/03/2026,0.0.1.0

[Manufacturer]
%Provider% = Models,NTarm

[Models.NTarm]
%Device% = Install, ACPI\MOU0001

[Install.NT]
CopyFiles = DriverCopy

[Install.NT.HW]
AddReg=FilterReg

[FilterReg]
HKR,,LowerFilters,0x00010008,"A04SharedEmmcFilter"

[Install.NT.Services]
AddService = Mt8167MsdcReadonly,0x00000002,Service
AddService = A04SharedEmmcFilter,0,FilterService

[DestinationDirs]
DriverCopy = 12

[DriverCopy]
mt8167-msdc.sys
parent-probe.sys

[Service]
DisplayName = %Device%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\mt8167-msdc.sys
LoadOrderGroup = SCSI Miniport

[FilterService]
DisplayName = %FilterDevice%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %12%\parent-probe.sys

[Install.NT.Wdf]
KmdfService = A04SharedEmmcFilter,FilterWdf

[FilterWdf]
KmdfLibraryVersion = 1.13

[SourceDisksNames]
1 = %Disk%,,,

[SourceDisksFiles]
mt8167-msdc.sys = 1
parent-probe.sys = 1

[Strings]
FilterDevice = "MT8167 Shared eMMC Offline Lower Filter"
Provider = "TAB-A04-BR3 development"
Device = "MediaTek MT8167 MSDC eMMC Host Controller"
Disk = "MediaTek MT8167 MSDC eMMC Driver"
