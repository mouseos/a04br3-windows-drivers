[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
DriverVer=11/03/2026,0.0.1.0
CatalogFile=a04touch.cat

[Manufacturer]
%Provider%=Models,NTARM

[Models.NTARM]
%Device%=Install,ACPI\MOU0004

[DestinationDirs]
DriverCopy=12

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
a04touch.sys=1

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
a04touch.sys

[Install.NT.HW]
AddReg=Filter

[Filter]
HKR,,LowerFilters,0x00010000,"A04Touch"

[Install.NT.Services]
AddService=mshidkmdf,0x00000002,HidService
AddService=A04Touch,0,TouchService

[HidService]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\mshidkmdf.sys

[TouchService]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\a04touch.sys

[Install.NT.Wdf]
KmdfService=A04Touch,Wdf

[Wdf]
KmdfLibraryVersion=1.13

[Strings]
Provider="mouseos"
Device="ROHM BU21025 Touchscreen"
Disk="ROHM BU21025 Touchscreen Driver"
