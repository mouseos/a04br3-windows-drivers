; Native 802.11 whole-combo cold-start runtime. Target signing and validation required.
[Version]
Signature="$WINDOWS NT$"
Class=Net
ClassGuid={4d36e972-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/06/2026,2026.11.6.1007
CatalogFile=mt6630-runtime.cat

[Manufacturer]
%Provider%=Models,NTARM

[Models.NTARM]
%Device%=Install,A04BR3\MT6630SDIO

[DestinationDirs]
DriverCopy=12

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
mt6630-runtime.sys=1

[Install.NT]
CopyFiles=DriverCopy
Characteristics=0x84
BusType=0x0f
; Mandatory NDIS connectionless keywords belong to DDInstall itself.
*IfType=71
*MediaType=16
*PhysicalMediaType=9
AddReg=NetworkConfig

[DriverCopy]
mt6630-runtime.sys

[Install.NT.Services]
AddService=Mt6630Runtime,0x00000002,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
Dependencies=a04msdcboot
ErrorControl=1
ServiceBinary=%12%\mt6630-runtime.sys

[Install.NT.CoInstallers]

[Strings]
Provider="mouseos"
Device="MediaTek MT6630 Wireless LAN SDIO Adapter"
Disk="MediaTek MT6630 Wireless LAN SDIO Adapter Driver"

[NetworkConfig]
HKR,Ndi,Service,,Mt6630Runtime
HKR,Ndi\Interfaces,UpperRange,,"ndis5"
HKR,Ndi\Interfaces,LowerRange,,"wlan,ethernet"
