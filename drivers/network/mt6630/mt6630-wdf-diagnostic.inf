; Test-signed diagnostic; board configuration and parent ownership gates remain closed.
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/06/2026,0.0.1.0
CatalogFile=mt6630-wdf-diagnostic.cat

[Manufacturer]
%Provider%=Models,NTARM

[Models.NTARM]
%Device%=Install,A04BR3\MT6630SDIO

[DestinationDirs]
DriverCopy=12

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
mt6630-wdf-diagnostic.sys=1

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
mt6630-wdf-diagnostic.sys

[Install.NT.Services]
AddService=Mt6630WdfDiagnostic,0x00000002,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\mt6630-wdf-diagnostic.sys

[Install.NT.Wdf]
KmdfService=Mt6630WdfDiagnostic,Wdf

[Wdf]
KmdfLibraryVersion=1.13

[Strings]
Provider="mouseos"
Device="MediaTek MT6630 Wireless LAN SDIO Adapter"
Disk="MT6630 diagnostic driver"
