; Exclusive MSDC2 Bluetooth profile. Requires the matching shared parent.
; Raw HCI diagnostic: None/0 does not meet the documented BTHX stack load contract.
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/06/2026,2026.11.7.2003
CatalogFile=mt6630-bluetooth.cat

[Manufacturer]
%Provider%=Models,NTARM

[Models.NTARM]
%Device%=Install,A04BR3\MT6630BGF

[DestinationDirs]
DriverCopy=12

[SourceDisksNames]
1=%Disk%,,,

[SourceDisksFiles]
mt6630-bluetooth.sys=1

[Install.NT]
CopyFiles=DriverCopy

[DriverCopy]
mt6630-bluetooth.sys

[Install.NT.Services]
AddService=Mt6630Bluetooth,0x00000002,Service

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\mt6630-bluetooth.sys

[Install.NT.Wdf]
KmdfService=Mt6630Bluetooth,Wdf

[Wdf]
KmdfLibraryVersion=1.13

[Strings]
Provider="mouseos"
Device="MediaTek MT6630 Bluetooth (SDIO/STP)"
Disk="MT6630 Bluetooth transport driver"
