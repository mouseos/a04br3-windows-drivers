; Separate root bus client; never a second physical MSDC2 owner.
; None/0 is deliberately not advertised as Windows RT standard stack compatible.
[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/07/2026,2026.11.8.2011
CatalogFile=mt6630-combo-bluetooth.cat
[Manufacturer]
%Provider%=Models,NTARM
[Models.NTARM]
%Device%=Install,ROOT\MT6630COMBO
[DestinationDirs]
Copy=12
[SourceDisksNames]
1=%Device%,,,
[SourceDisksFiles]
mt6630-combo-bluetooth.sys=1
[Install.NT]
CopyFiles=Copy
[Copy]
mt6630-combo-bluetooth.sys
[Install.NT.Services]
AddService=Mt6630ComboBluetooth,0x00000002,Service
[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
Dependencies=Mt6630Runtime
ServiceBinary=%12%\mt6630-combo-bluetooth.sys
[Install.NT.Wdf]
KmdfService=Mt6630ComboBluetooth,Wdf
[Wdf]
KmdfLibraryVersion=1.13
[Strings]
Provider="mouseos"
Device="MediaTek MT6630 Bluetooth (shared SDIO/STP)"
