[Version]
Signature="$WINDOWS NT$"
Class=HIDClass
ClassGuid={745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider=%Provider%
DriverVer=11/06/2026,0.0.2.0
CatalogFile=mma8652.cat

[Manufacturer]
%Provider%=Models,NTARM

[Models.NTARM]
%Device%=Install,ACPI\MOU0010

[DestinationDirs]
