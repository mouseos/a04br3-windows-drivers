StartType=3
ErrorControl=1
ServiceBinary=%12%\mshidkmdf.sys

[Service]
DisplayName=%Device%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\mma8652.sys

[Install.NT.Wdf]
KmdfService=A04Mma8652,Wdf

[Wdf]
