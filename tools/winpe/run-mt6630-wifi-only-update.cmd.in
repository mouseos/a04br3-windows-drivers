@echo off
setlocal EnableExtensions DisableDelayedExpansion
rem WiFi1029 only. Existing maintenance map/guard/DISM/release/UART path.
rem The real host fresh206 backup is required; no backup is invented here.
set "A04_REPORT=X:\a04br3\toprgu-audit-result.txt"
set "A04_BK=C:\a04backup\wifi1029-@TOKEN@"
set "A04_RC=2"
set "A04_STATUS=PRECHECK_FAILED_NO_CHANGE"
set "A04_JOURNALED=0"
> "%A04_REPORT%" echo UPDATE_BEGIN
>> "%A04_REPORT%" echo HOST_BACKUP_MANIFEST_SHA256=@HOST_BACKUP_SHA@
>> "%A04_REPORT%" echo HOST_RECOVERY_BOOT_ID=@RECOVERY_BOOT_ID@
X:\a04br3\observe-msdc-storage.exe >> "%A04_REPORT%" 2>&1
if "%errorlevel%"=="0" goto storageobserved
X:\a04br3\observe-msdc-storage.exe --verify-package >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto packagefail
drvload X:\a04br3\a04-msdc-probe.inf >> "%A04_REPORT%" 2>&1
>> "%A04_REPORT%" echo MSDC_DRVLOAD_EXIT=%errorlevel%
:storageobserved
set /a A04_MAP_ATTEMPTS=0
:mapretry
set /a A04_MAP_ATTEMPTS+=1
X:\a04br3\map-offline-windows.exe >> "%A04_REPORT%" 2>&1
set "A04_MAP_RC=%errorlevel%"
>> "%A04_REPORT%" echo A04MAP_EXIT=%A04_MAP_RC%
if "%A04_MAP_RC%"=="0" goto mapped
if not "%A04_MAP_RC%"=="4" goto mapfail
if %A04_MAP_ATTEMPTS% GEQ 6 goto mapfail
X:\a04br3\observe-msdc-storage.exe --wait >> "%A04_REPORT%" 2>&1
goto mapretry
:mapped
X:\a04br3\guard-windows-volume.exe >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto guardfail
if not exist "C:\Windows\System32\config\SYSTEM" goto guardfail
if exist "%A04_BK%" goto journalexists
mkdir "%A04_BK%" >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto journalfail
set "A04_JOURNALED=1"
> "%A04_BK%\JOURNAL.txt" echo STATE=ATTEMPTED_ONCE
if errorlevel 1 goto journalfail
>> "%A04_BK%\JOURNAL.txt" echo HOST_BACKUP_MANIFEST_SHA256=@HOST_BACKUP_SHA@
if errorlevel 1 goto journalfail
rem ForceUnsigned is the established PE servicing workaround, not runtime CI.
rem Host pins final signed SYS/CAT/INF; main verifies actual membership logs.
dism.exe /Image:C:\ /Add-Driver /Driver:X:\a04br3\wifi-only\mt6630-combo-runtime.inf /ForceUnsigned /ScratchDir:X:\Windows\Temp /LogPath:X:\a04br3\dism-WIFI.log > X:\a04br3\dism-WIFI.txt 2>&1
set "A04_DISM=%errorlevel%"
type X:\a04br3\dism-WIFI.txt >> "%A04_REPORT%"
>> "%A04_REPORT%" echo UPDATE_DISM_WIFI_EXIT=%A04_DISM%
if "%A04_DISM%"=="0" goto serviced
if "%A04_DISM%"=="3010" goto serviced
goto dismfail
:serviced
rem DISM 3010 is success-with-reboot; clear it before checking journal I/O.
cmd.exe /c exit 0
> "%A04_BK%\JOURNAL.txt" echo STATE=SERVICED_AWAIT_VOLUME_RELEASE
if errorlevel 1 goto journalfail
set "A04_STATUS=COMMITTED"
set "A04_RC=0"
goto release
:dismfail
> "%A04_BK%\JOURNAL.txt" echo STATE=DISM_FAILED_RESTORE_FROM_HOST_BACKUP
set "A04_STATUS=DISM_FAILED_RESTORE_FROM_HOST_BACKUP"
set "A04_RC=6"
goto release
:journalfail
set "A04_STATUS=JOURNAL_FAILED_NO_RETRY"
set "A04_RC=5"
goto release
:journalexists
type "%A04_BK%\JOURNAL.txt" >> "%A04_REPORT%" 2>&1
set "A04_STATUS=JOURNAL_EXISTS_NO_CHANGE"
set "A04_RC=4"
goto release
:guardfail
set "A04_STATUS=VOLUME_IDENTITY_REJECTED"
goto release
:packagefail
set "A04_STATUS=MSDC_PACKAGE_PIN_REJECTED"
goto transmit
:mapfail
set "A04_STATUS=VOLUME_MAPPING_REJECTED"
goto transmit
:release
if "%A04_JOURNALED%"=="1" copy /y X:\a04br3\dism-WIFI.* "%A04_BK%\" >nul 2>&1
if "%A04_JOURNALED%"=="1" copy /y "%A04_REPORT%" "%A04_BK%\prepare-report.txt" >nul 2>&1
X:\a04br3\release-offline-volume.exe >> "%A04_REPORT%" 2>&1
set "A04_RELEASE_RC=%errorlevel%"
>> "%A04_REPORT%" echo UPDATE_RELEASE_EXIT=%A04_RELEASE_RC%
if "%A04_RELEASE_RC%"=="0" goto transmit
set "A04_STATUS=VOLUME_RELEASE_FAILED"
set "A04_RC=8"
:transmit
>> "%A04_REPORT%" echo UPDATE_STATUS=%A04_STATUS%
>> "%A04_REPORT%" echo UPDATE_EXIT=%A04_RC%
X:\a04br3\uart-audit-stream.exe @TOKEN@
exit /b %A04_RC%
