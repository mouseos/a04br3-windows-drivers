@echo off
title TAB-A04-BR3 CPU watchdog audit
wpeinit
drvload X:\a04br3\a04-msdc-probe.inf
if errorlevel 1 goto storagefail
call X:\a04br3\audit-toprgu-installed.cmd > X:\a04br3\toprgu-audit-result.txt 2>&1
set "A04_AUDIT_RC=%errorlevel%"
>> X:\a04br3\toprgu-audit-result.txt echo TOPRGU_AUDIT_EXIT=%A04_AUDIT_RC%
if "%A04_AUDIT_RC%"=="0" goto release
if "%A04_AUDIT_RC%"=="2" goto release
if not "%A04_AUDIT_RC%"=="3" goto transmit
:release
call X:\a04br3\release-toprgu-audit-volume.cmd >> X:\a04br3\toprgu-audit-result.txt 2>&1
set "A04_RELEASE_RC=%errorlevel%"
>> X:\a04br3\toprgu-audit-result.txt echo TOPRGU_RELEASE_EXIT=%A04_RELEASE_RC%
goto transmit
:storagefail
> X:\a04br3\toprgu-audit-result.txt echo TOPRGU_AUDIT_STORAGE_FAILED
>> X:\a04br3\toprgu-audit-result.txt echo TOPRGU_AUDIT_EXIT=2
:transmit
X:\a04br3\uart-cpu-report.exe @TOKEN@
echo TOPRGU_UART_QUEUE_EXIT=%errorlevel%
rem Never reset or service disks; the host validates the complete UART frame.
