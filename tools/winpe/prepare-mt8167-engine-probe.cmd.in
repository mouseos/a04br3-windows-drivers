rem Separate fixed Engine service; never delete/rearm the old tone marker or service.
if exist C:\Windows\System32\MT8167EngineProbe\attempted.bin goto dismfail
if not exist C:\Windows\System32\MT8167EngineProbe mkdir C:\Windows\System32\MT8167EngineProbe >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
if not exist C:\Windows\System32\MT8167EngineProbe\clients mkdir C:\Windows\System32\MT8167EngineProbe\clients >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
if not exist C:\Windows\System32\MT8167EngineProbe\logs mkdir C:\Windows\System32\MT8167EngineProbe\logs >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /y X:\a04br3\shared-io\clients\mt6630-wlan-probe.exe C:\Windows\System32\MT8167EngineProbe\clients\ >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /y X:\a04br3\shared-io\clients\mt8167-audio-engine-probe.exe C:\Windows\System32\MT8167EngineProbe\clients\ >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
if not exist C:\Windows\System32\MT8167EngineProbe\drivers mkdir C:\Windows\System32\MT8167EngineProbe\drivers >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
if not exist C:\Windows\System32\MT8167EngineProbe\drivers\audio mkdir C:\Windows\System32\MT8167EngineProbe\drivers\audio >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
if not exist C:\Windows\System32\MT8167EngineProbe\drivers\usb mkdir C:\Windows\System32\MT8167EngineProbe\drivers\usb >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
if not exist C:\Windows\System32\MT8167EngineProbe\drivers\wifi mkdir C:\Windows\System32\MT8167EngineProbe\drivers\wifi >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /b /y X:\a04br3\shared-io\audio\mt8167-afe-engine-pcm.inf C:\Windows\System32\MT8167EngineProbe\drivers\audio\mt8167-afe-engine-pcm.inf >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /b /y X:\a04br3\shared-io\audio\mt8167-audio.sys C:\Windows\System32\MT8167EngineProbe\drivers\audio\mt8167-audio.sys >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /b /y X:\a04br3\shared-io\audio\mt8167-afe-engine-pcm.cat C:\Windows\System32\MT8167EngineProbe\drivers\audio\mt8167-afe-engine-pcm.cat >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /b /y X:\a04br3\shared-io\usb\mt8167-usb20.inf C:\Windows\System32\MT8167EngineProbe\drivers\usb\mt8167-usb20.inf >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /b /y X:\a04br3\shared-io\usb\mt8167-usb20.sys C:\Windows\System32\MT8167EngineProbe\drivers\usb\mt8167-usb20.sys >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /b /y X:\a04br3\shared-io\usb\mt8167-usb20.cat C:\Windows\System32\MT8167EngineProbe\drivers\usb\mt8167-usb20.cat >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /b /y X:\a04br3\shared-io\wifi\mt6630-runtime.inf C:\Windows\System32\MT8167EngineProbe\drivers\wifi\mt6630-runtime.inf >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /b /y X:\a04br3\shared-io\wifi\mt6630-runtime.sys C:\Windows\System32\MT8167EngineProbe\drivers\wifi\mt6630-runtime.sys >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /b /y X:\a04br3\shared-io\wifi\mt6630-runtime.cat C:\Windows\System32\MT8167EngineProbe\drivers\wifi\mt6630-runtime.cat >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /y X:\a04br3\MT8167EngineProbe.exe C:\Windows\System32\MT8167EngineProbe.exe >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
>> "%A04_REPORT%" echo SYSTEM_INPUT_SHA256=@SYSTEM_SHA@
>> "%A04_REPORT%" echo SYSTEM_NATIVE_MANIFEST_SHA256=@SYSTEM_MANIFEST_SHA@
copy /b /y X:\a04br3\private-system\SYSTEM.patched C:\Windows\System32\config\SYSTEM >> "%A04_REPORT%" 2>&1
set "A04_SYSTEM_COPY_RC=%errorlevel%"
>> "%A04_REPORT%" echo UPDATE_ENGINE_SYSTEM_COPY_EXIT=%A04_SYSTEM_COPY_RC%
if not "%A04_SYSTEM_COPY_RC%"=="0" goto dismfail
rem Four-driver DISM runs afterwards and preserves this independently prepared Engine service.
