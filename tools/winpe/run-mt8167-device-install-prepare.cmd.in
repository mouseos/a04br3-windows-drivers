@echo off
setlocal EnableExtensions DisableDelayedExpansion
rem Adapted from the tested installed-driver transaction in mouseos/a04br3-windows-drivers.
rem Prepare one-shot standard PnP installation in installed Windows. No GPU workload here.
set "A04_REPORT=X:\a04br3\toprgu-audit-result.txt"
set "A04_BK=C:\a04backup\device-install-@JOURNAL@"
> "%A04_REPORT%" echo UPDATE_BEGIN
X:\a04br3\observe-msdc-storage.exe >> "%A04_REPORT%" 2>&1
if "%errorlevel%"=="0" goto storageobserved
X:\a04br3\observe-msdc-storage.exe --verify-package >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto packagefail
drvload X:\a04br3\a04-msdc-probe.inf >> "%A04_REPORT%" 2>&1
>> "%A04_REPORT%" echo MSDC_DRVLOAD_EXIT=%errorlevel%
:storageobserved
set /a A04_MAP_ATTEMPTS=0
:mapretry
set /a A04_MAP_ATTEMPTS+=1
>> "%A04_REPORT%" echo A04MAP_ATTEMPT=%A04_MAP_ATTEMPTS%
X:\a04br3\map-offline-windows.exe >> "%A04_REPORT%" 2>&1
set "A04_MAP_RC=%errorlevel%"
>> "%A04_REPORT%" echo A04MAP_EXIT=%A04_MAP_RC%
if "%A04_MAP_RC%"=="0" goto mapped
if not "%A04_MAP_RC%"=="4" goto mapfail
if %A04_MAP_ATTEMPTS% GEQ 6 goto mapfail
X:\a04br3\observe-msdc-storage.exe --wait >> "%A04_REPORT%" 2>&1
goto mapretry
:mapped
X:\a04br3\guard-windows-volume.exe >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto guardfail
if not exist "C:\Windows\System32\config\SYSTEM" goto guardfail
if exist "%A04_BK%" goto journalexists
mkdir "%A04_BK%" >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto backupfail
> "%A04_BK%\JOURNAL.txt" echo STATE=PREPARE_STARTED
copy /y C:\Windows\System32\config\SYSTEM "%A04_BK%\SYSTEM.before" >nul
if errorlevel 1 goto backupfail
copy /y C:\Windows\System32\config\SOFTWARE "%A04_BK%\SOFTWARE.before" >nul
if errorlevel 1 goto backupfail
for %%H in (SYSTEM.LOG1 SYSTEM.LOG2 SOFTWARE.LOG1 SOFTWARE.LOG2) do (
  if exist C:\Windows\System32\config\%%H copy /y C:\Windows\System32\config\%%H "%A04_BK%\%%H.before" >nul
  if errorlevel 1 goto backupfail
)
reg.exe load HKLM\Mt8167GpuOffline C:\Windows\System32\config\SOFTWARE >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
@TRUST_COMMANDS@
reg.exe unload HKLM\Mt8167GpuOffline >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
if exist C:\Windows\System32\MT8167DeviceInstall\attempted.bin goto dismfail
mkdir C:\Windows\System32\MT8167DeviceInstall\display >> "%A04_REPORT%" 2>&1
copy /y X:\a04br3\upd\display\* C:\Windows\System32\MT8167DeviceInstall\display\ >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
copy /y X:\a04br3\upd\MT8167DeviceInstall.exe C:\Windows\System32\MT8167DeviceInstall.exe >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
reg.exe load HKLM\Mt8167InstallSystem C:\Windows\System32\config\SYSTEM >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
rem This media targets the observed installed image; reject another active control set.
reg.exe query HKLM\Mt8167InstallSystem\Select /v Current | findstr /r /c:"0x1$" >nul
if errorlevel 1 goto systemfail
set "A04_SVC=HKLM\Mt8167InstallSystem\ControlSet001\Services\MT8167DeviceInstall"
reg.exe query "%A04_SVC%" >nul 2>&1
if not errorlevel 1 goto systemfail
reg.exe add "%A04_SVC%" /v Type /t REG_DWORD /d 16 /f >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto systemfail
reg.exe add "%A04_SVC%" /v Start /t REG_DWORD /d 2 /f >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto systemfail
reg.exe add "%A04_SVC%" /v ErrorControl /t REG_DWORD /d 1 /f >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto systemfail
reg.exe add "%A04_SVC%" /v ImagePath /t REG_EXPAND_SZ /d C:\Windows\System32\MT8167DeviceInstall.exe /f >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto systemfail
reg.exe add "%A04_SVC%" /v ObjectName /t REG_SZ /d LocalSystem /f >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto systemfail
reg.exe add "%A04_SVC%" /v DisplayName /t REG_SZ /d "MediaTek MT8167 Device Installation" /f >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto systemfail
reg.exe unload HKLM\Mt8167InstallSystem >> "%A04_REPORT%" 2>&1
if errorlevel 1 goto dismfail
> "%A04_BK%\JOURNAL.txt" echo STATE=COMMITTED
>> "%A04_REPORT%" echo UPDATE_STATUS=COMMITTED
set "A04_RC=0"
goto release
:systemfail
reg.exe unload HKLM\Mt8167InstallSystem >> "%A04_REPORT%" 2>&1
goto dismfail
:trustfail
reg.exe unload HKLM\Mt8167GpuOffline >> "%A04_REPORT%" 2>&1
:dismfail
> "%A04_BK%\JOURNAL.txt" echo STATE=PREPARE_FAILED
>> "%A04_REPORT%" echo UPDATE_STATUS=PREPARE_FAILED
set "A04_RC=6"
goto release
:backupfail
>> "%A04_REPORT%" echo UPDATE_STATUS=BACKUP_FAILED_NO_CHANGE
set "A04_RC=5"
goto release
:journalexists
type "%A04_BK%\JOURNAL.txt" >> "%A04_REPORT%" 2>&1
>> "%A04_REPORT%" echo UPDATE_STATUS=JOURNAL_EXISTS_NO_CHANGE
set "A04_RC=4"
goto release
:release
X:\a04br3\release-offline-volume.exe >> "%A04_REPORT%" 2>&1
set "A04_RELEASE_RC=%errorlevel%"
>> "%A04_REPORT%" echo UPDATE_RELEASE_EXIT=%A04_RELEASE_RC%
goto transmit
:packagefail
>> "%A04_REPORT%" echo UPDATE_STATUS=MSDC_PACKAGE_PIN_REJECTED
set "A04_RC=2"
goto transmit
:mapfail
>> "%A04_REPORT%" echo UPDATE_STATUS=VOLUME_MAPPING_REJECTED
set "A04_RC=2"
goto transmit
:guardfail
>> "%A04_REPORT%" echo UPDATE_STATUS=VOLUME_IDENTITY_REJECTED
set "A04_RC=2"
:transmit
>> "%A04_REPORT%" echo UPDATE_EXIT=%A04_RC%
if exist "%A04_BK%" copy /y "%A04_REPORT%" "%A04_BK%\prepare-report.txt" >nul
X:\a04br3\uart-audit-stream.exe @TOKEN@
exit /b %A04_RC%
